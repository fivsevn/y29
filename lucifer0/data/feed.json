  "posts": [
    {
      "id": "l0-20261109005357-b42d24e5-09",
      "author": "guest-l0-20261109005357-b42d24e5-three",
      "createdAt": "2026-11-09T08:57:00+08:00",
      "replyTo": "l0-20261109005357-b42d24e5-04",
      "likes": 0,
      "canon": "derivative",
      "media": [
        {
          "src": "posts/2026/11/l0-20261109005357-b42d24e5-03/media/l0-20261109005357-b42d24e5-09.png",
          "alt": "一只松鼠抱紧空车位的照片，头顶的想象框里也是同一个车位。"
        }
      ],
      "guest": {
        "name": "叁叁"
      },
      "text": "这个我倒留着，下次去还想停原来的地方。"
    },
    {
      "id": "l0-20261109005357-b42d24e5-08",
      "author": "guest-l0-20261109005357-b42d24e5-box",
      "createdAt": "2026-11-09T08:53:00+08:00",
      "replyTo": "l0-20261109005357-b42d24e5-05",
      "likes": 2,
      "canon": "derivative",
      "media": [],
      "guest": {
        "name": "纸盒_3"
      },
      "text": "这么大字也能拍糊？"
    },
    {
      "id": "l0-20261109005357-b42d24e5-07",
      "author": "guest-l0-20261109005357-b42d24e5-album",
      "createdAt": "2026-11-09T08:49:00+08:00",
      "replyTo": "l0-20261109005357-b42d24e5-06",
      "likes": 3,
      "canon": "derivative",
      "media": [],
      "guest": {
        "name": "nana_17"
      },
      "text": "也看不出，背景全是地砖。"
    },
    {
      "id": "l0-20261109005357-b42d24e5-06",
      "author": "guest-l0-20261109005357-b42d24e5-lift",
      "createdAt": "2026-11-09T08:46:00+08:00",
      "replyTo": "l0-20261109005357-b42d24e5-03",
      "likes": 1,
      "canon": "derivative",
      "media": [],
      "guest": {
        "name": "电梯向下"
      },
      "text": "鞋那张别删，至少能看出你去过。"
    },
    {
      "id": "l0-20261109005357-b42d24e5-05",
      "author": "visitor-chi",
      "createdAt": "2026-11-09T08:44:00+08:00",
      "replyTo": "l0-20261109005357-b42d24e5-03",
      "likes": 6,
      "canon": "derivative",
      "media": [
        {
          "src": "posts/2026/11/l0-20261109005357-b42d24e5-03/media/l0-20261109005357-b42d24e5-05.png",
          "alt": "隔着反光玻璃拍糊的展柜说明牌，字迹模糊，上方露出一小部分陶器。"
        }
      ],
      "text": "说明牌我也拍。拍糊了还会重新排队拍一次，回去根本没点开。"
    },
    {
      "id": "l0-20261109005357-b42d24e5-04",
      "author": "guest-l0-20261109005357-b42d24e5-seven",
      "createdAt": "2026-11-09T08:42:00+08:00",
      "replyTo": "l0-20261109005357-b42d24e5-03",
      "likes": 0,
      "canon": "derivative",
      "media": [
        {
          "src": "posts/2026/11/l0-20261109005357-b42d24e5-03/media/l0-20261109005357-b42d24e5-04.png",
          "alt": "地下停车场的旧照片，橙色立柱上写着 B2，旁边露出半辆银色车和空车位。"
        }
      ],
      "guest": {
        "name": "七分困"
      },
      "text": "我有一张两年前的停车位置。车后来都换了，它还在。"
    },
    {
      "id": "l0-20261109005357-b42d24e5-03",
      "author": "guest-l0-20261109005357-b42d24e5-album",
      "createdAt": "2026-11-09T08:38:00+08:00",
      "replyTo": null,
      "likes": 4,
      "canon": "derivative",
      "media": [
        {
          "src": "posts/2026/11/l0-20261109005357-b42d24e5-03/media/l0-20261109005357-b42d24e5-03.png",
          "alt": "朝下误拍的照片，灰色地砖占满画面，底部露出白色旧球鞋和一截绿色裤脚。"
        }
      ],
      "guest": {
        "name": "nana_17"
      },
      "text": "本来想腾点空间，翻到一排展柜说明牌。拍了23张，一张没读。还翻出一张我的鞋，不记得什么时候拍的。"
    },
    {
      "id": "l0-20261109005357-b42d24e5-02",
      "author": "visitor-tau",
      "createdAt": "2026-11-09T08:31:00+08:00",
      "replyTo": null,
      "likes": 10,
      "canon": "derivative",
      "media": [
        {
          "src": "posts/2026/11/l0-20261109005357-b42d24e5-02/media/l0-20261109005357-b42d24e5-02.png",
          "alt": "模糊的旧球赛画面，守门员在球门里弯腰捡球，其他球员已向外走，底部有播放进度条。"
        }
      ],
      "text": "车停好刷个旧集锦，明明知道后面那脚会进，还是看紧张了。结果快进过头，进球没了，只剩解说在喊。又拖回去。"
    },
    {
      "id": "l0-20261109005357-b42d24e5-01",
      "author": "news-neon",
      "createdAt": "2026-11-09T08:25:00+08:00",
      "replyTo": null,
      "likes": 13,
      "canon": "derivative",
      "media": [],
      "text": "城南晚场消息：回声厅、旧船坞本周五起，会在入场提示里附上夜间上车点和散场步行出口。两家场馆的回访里，有观众没等到加演就走，怕散场后找不到车。先试两个周末，进场时可以留意一下。"
    },
    {
      "id": "l0-20261108232431-2cf51564-20",
      "author": "guest-l0-20261108232431-2cf51564-lamp",
      "createdAt": "2026-11-09T07:10:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-05",
      "likes": 1,
      "canon": "derivative",
      "media": [],
      "guest": {
        "name": "靠窗那盏灯"
      },
      "text": "我手机到60就不想出门了，主要上次回来还要靠它开门。"
    },
    {
      "id": "l0-20261108232431-2cf51564-19",
      "author": "guest-l0-20261108232431-2cf51564-teabags",
      "createdAt": "2026-11-09T07:08:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-18",
      "likes": 8,
      "canon": "derivative",
      "media": [],
      "guest": {
        "name": "茶袋两包"
      },
      "text": "我没贴纸，是脏。擦了一下它终于开始充了。"
    },
    {
      "id": "l0-20261108232431-2cf51564-18",
      "author": "guest-l0-20261108232431-2cf51564-little",
      "createdAt": "2026-11-09T07:04:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-05",
      "likes": 6,
      "canon": "derivative",
      "media": [],
      "guest": {
        "name": "一点点就行"
      },
      "text": "充电盒有电不代表耳机有电。我昨天才知道触点上还有贴纸。"
    },
    {
      "id": "l0-20261108232431-2cf51564-05",
      "author": "guest-l0-20261108232431-2cf51564-battery",
      "createdAt": "2026-11-09T06:58:00+08:00",
      "replyTo": null,
      "likes": 2,
      "canon": "derivative",
      "media": [],
      "guest": {
        "name": "电量随缘"
      },
      "text": "手机剩9%就开始找线，耳机剩1%还觉得能再听两首。现在手机满的，耳机一点声也没了。"
    },
    {
      "id": "l0-20261108232431-2cf51564-11",
      "author": "guest-l0-20261108232431-2cf51564-porridge",
      "createdAt": "2026-11-08T22:37:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-08",
      "likes": 19,
      "canon": "derivative",
      "media": [],
      "guest": {
        "name": "稀饭不烫"
      },
      "text": "别笑，我那段副歌全是塑料袋声。进场前买的薯片。"
    },
    {
      "id": "l0-20261108232431-2cf51564-10",
      "author": "baiyanyan",
      "createdAt": "2026-11-08T22:30:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-07",
      "likes": 9,
      "canon": "derivative",
      "media": [],
      "text": "现场别人得听三遍，你自己一遍就受不了了？"
    },
    {
      "id": "l0-20261108232431-2cf51564-09",
      "author": "guest-l0-20261108232431-2cf51564-drummer",
      "createdAt": "2026-11-08T22:27:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-07",
      "likes": 6,
      "canon": "derivative",
      "media": [
        {
          "src": "posts/2026/11/l0-20261108232431-2cf51564-01/media/l0-20261108232431-2cf51564-09.png",
          "alt": "小黄鸭听到自己的录音后发愣，脑中仍是自信唱歌的样子。"
        }
      ],
      "guest": {
        "name": "不是鼓手"
      },
      "text": "所以你回家才第一次听到自己唱的版本"
    },
    {
      "id": "l0-20261108232431-2cf51564-08",
      "author": "guest-l0-20261108232431-2cf51564-track",
      "createdAt": "2026-11-08T22:24:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-01",
      "likes": 23,
      "canon": "derivative",
      "media": [
        {
          "src": "posts/2026/11/l0-20261108232431-2cf51564-01/media/l0-20261108232431-2cf51564-08.png",
          "alt": "手指贴住手机底部麦克风附近的示意随拍。"
        }
      ],
      "guest": {
        "name": "未命名音轨"
      },
      "text": "先别删，我有一段只剩自己喘气。找了半天才发现手指压住麦了。"
    },
    {
      "id": "l0-20261108232431-2cf51564-07",
      "author": "lidianlong",
      "createdAt": "2026-11-08T22:22:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-06",
      "likes": 5,
      "canon": "derivative",
      "media": [
        {
          "src": "posts/2026/11/l0-20261108232431-2cf51564-01/media/l0-20261108232431-2cf51564-07.png",
          "alt": "手机上显示一段录音波形，桌边放着耳机和红色纸手环。"
        }
      ],
      "text": "没保安。录到我跟着喊了三遍副歌，词还不对。"
    },
    {
      "id": "l0-20261108232431-2cf51564-06",
      "author": "guest-l0-20261108232431-2cf51564-wind",
      "createdAt": "2026-11-08T22:19:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-01",
      "likes": 0,
      "canon": "derivative",
      "media": [
        {
          "src": "posts/2026/11/l0-20261108232431-2cf51564-01/media/l0-20261108232431-2cf51564-06.png",
          "alt": "散场的人群往门口走，一名穿反光背心的工作人员指着出口。"
        }
      ],
      "guest": {
        "name": "拐角有风"
      },
      "text": "是不是还有一句“让一下”？我上回录进去保安喊我挪地方。"
    },
    {
      "id": "l0-20261108232431-2cf51564-01",
      "author": "lidianlong",
      "createdAt": "2026-11-08T22:16:00+08:00",
      "replyTo": null,
      "likes": 19,
      "canon": "derivative",
      "media": [
        {
          "src": "posts/2026/11/l0-20261108232431-2cf51564-01/media/l0-20261108232431-2cf51564-01.png",
          "alt": "音乐现场的鼓组和吉他手，台下观众与紫绿灯光晃成一片。"
        }
      ],
      "text": "昨晚最后那首我举着手机录完了。刚才听了一遍，鼓全糊了，我自己唱的倒一句没少。能不能单独把我关掉。"
    },
    {
      "id": "l0-20261108232431-2cf51564-17",
      "author": "guest-l0-20261108232431-2cf51564-window",
      "createdAt": "2026-11-08T20:48:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-04",
      "likes": 1,
      "canon": "derivative",
      "media": [],
      "guest": {
        "name": "周末才开窗"
      },
      "text": "我倒想试，工作群也能这么回就好了。"
    },
    {
      "id": "l0-20261108232431-2cf51564-04",
      "author": "guest-l0-20261108232431-2cf51564-orange",
      "createdAt": "2026-11-08T20:25:00+08:00",
      "replyTo": null,
      "likes": 1,
      "canon": "derivative",
      "media": [],
      "guest": {
        "name": "半箱橘子"
      },
      "text": "澄湾天文馆新放的那个延迟通信小展项，点一下，屏幕说对方明天才能收到。我退出去了。平时等消息就够了，买张票还等。"
    },
    {
      "id": "l0-20261108232431-2cf51564-14",
      "author": "guest-l0-20261108232431-2cf51564-buttons",
      "createdAt": "2026-11-08T20:03:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-13",
      "likes": 2,
      "canon": "derivative",
      "media": [],
      "guest": {
        "name": "两粒纽扣"
      },
      "text": "他早起是节目里说的，还是你替他想的"
    },
    {
      "id": "l0-20261108232431-2cf51564-13",
      "author": "visitor-psi-upper",
      "createdAt": "2026-11-08T19:48:00+08:00",
      "replyTo": "l0-20261108232431-2cf51564-12",
