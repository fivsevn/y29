      "media": [
        {
          "src": "posts/2026/11/l0-20261108232431-2cf51564-02/media/l0-20261108232431-2cf51564-12.png",
          "alt": "兔子递过一杯水，同时指向敞开的门的聊天漫画。"
        }
      ],
      "guest": {
        "name": "夜里翻面"
      },
      "text": "喝完水就回去。你把后半句也听一下。"
    },
    {
      "id": "l0-20261108232431-2cf51564-02",
      "author": "visitor-psi-upper",
      "createdAt": "2026-11-08T19:37:00+08:00",
