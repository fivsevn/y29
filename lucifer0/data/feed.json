      },
      "text": "不想起床啊啊啊\n不想上班"
    },
    {
      "id": "l0-20261109212821-f9f00063-04",
      "author": "guest-6022ffba2330131e",
      "createdAt": "2026-11-08T23:02:16.021Z",
      "replyTo": null,
